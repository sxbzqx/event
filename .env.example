# Скопируйте в .env и поменяйте значения
POSTGRES_DB=event_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password   # без символов ; и = (используется в строке подключения)

# Порты 
CLIENT_PORT=3000
API_PORT=5280
DB_PORT=5434

# Адрес API, как его видит браузер (вшивается в клиент при сборке)
PUBLIC_API_URL=http://localhost:5280

# Origin фронтенда для CORS 
CORS_ORIGINS=http://localhost:3000

SWAGGER_ENABLED=true
